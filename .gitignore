# App-branch gitignore template for the schema repo.
# Use this when the repo is acting as an application-owned schema branch and
# should keep config files plus generated schema assets in git.

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov

# Logs
logs
*.log
sync-itemize.log

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary folders
tmp/
temp/
.tmp/
config/temp/
config/temp/*

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of `npm pack`
*.tgz

# Yarn Integrity file
.yarn-integrity

# Deploy cache
/.deploy/*

# Schema docs build output
schema-docs/.nuxt/
schema-docs/.output/
schema-docs/dist/
schema-docs/.nitro/
schema-docs/.cache/
schema-docs/test/capabilities/reports/
