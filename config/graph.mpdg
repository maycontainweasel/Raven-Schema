  playerCount: 0
  ageCategory!: "any", <"adult" | "junior" | "senior" | "any">
  minDurationHours: 1
  maxDurationHours: 4
  amount!: 0
  amountMode!: "per_hour", <"per_hour" | "flat_total">
  weekdayMask: []
  effectiveFrom: null, <datetime>
  effectiveTo: null, <datetime>
  priority: 0
  metadata: {}
} [
  crud<key>
  router
  views:
