// Raven financial operating system schema
// Raven is the application/codebase. Financial Mastery is the Orbit planning project.
//
// This graph is a parity baseline reconstructed from the current Raven generated
// model manifest, generated table types, and app import flow. It intentionally
// keeps the current generated contract narrow: CRUD + router + Admin views.
// Rich relation/taxonomy expansion can be layered on after this baseline
// validates cleanly and the app has regenerated from a stable source of truth.

User, u | Minimal Raven user profile {
  id: $email,
  email!: "", <email>
  uniqueId: "", <md5<$email>> <assign>
  firstName!: "",
  surname!: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*](),

  taxonomies:
    Role/Roles, role | User roles {} {
      hierarchical: false
      cardinality: one
      storeOnModel: true
      payloadField: role
      payloadAliases: [roles]
      required: true
      processor: functions
    }
]

FinancialSpace, financialSpace | Personal, business, trading, family, or other money context {
  id: $key,
  key!: "",
  name!: "",
  spaceType!: "personal", <"personal" | "business" | "trading" | "family" | "other">
  currency!: "ZAR",
  description: "",
  active!: true,
  archivedAt: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*]()
]

Account, account | Real-world bank, card, savings, loan, debt, investment, cash, or other account inside a financial space {
  id: $key,
  space!: "", <record<financialSpace>>
  key!: "",
  name!: "",
  bankName!: "",
  accountType!: "current", <"current" | "credit_card" | "savings" | "loan" | "debt" | "investment" | "cash" | "other">
  currency!: "ZAR",
  accountNumberLast4: "",
  openingBalance: 0,
  active!: true,
  notes: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*]()
]

StatementImport, statementImport | Source statement import batch for an account cycle {
  id: $key,
  space!: "", <record<financialSpace>>
  account!: "", <record<account>>
  key!: "",
  sourceFileName!: "",
  sourceFormat!: "pdf", <"csv" | "ofx" | "qif" | "pdf" | "manual">
  importedAt!: "",
  statementDate: "",
  status!: "raw", <"raw" | "parsed" | "matched" | "reviewed" | "error">
  rowCount: 0,
  normalizedCount: 0,
  clarificationCount: 0,
  sourceChecksum: "",
  notes: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*]()
]

StatementRow, statementRow | Raw statement row preserved from imported source material {
  id: default,
  space!: "", <record<financialSpace>>
  account!: "", <record<account>>
  statementImport!: "", <record<statementImport>>
  rowNumber!: 0,
  postedAt: "",
  description!: "",
  normalizedDescription: "",
  amount!: 0,
  balance: 0,
  currency!: "ZAR",
  direction!: "debit", <"debit" | "credit" | "transfer">
  status!: "raw", <"raw" | "normalized" | "matched" | "clarified" | "ignored">
  confidence: 0,
  rawData: {},
  transaction: "", <record<transaction>>
  notes: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*]()
]

Transaction, transaction | Normalized money movement derived from a statement row or manual entry {
  id: $key,
  space!: "", <record<financialSpace>>
  account!: "", <record<account>>
  key!: "",
  sourceRow: "", <record<statementRow>>
  postedAt!: "",
  effectiveAt: "",
  description!: "",
  normalizedDescription: "",
  amount!: 0,
  balance: 0,
  currency!: "ZAR",
  direction!: "debit", <"debit" | "credit" | "transfer">
  status!: "imported", <"imported" | "normalized" | "matched" | "classified" | "clarified" | "ignored">
  confidence: 0,
  merchantName: "",
  merchant: "", <record<merchant>>
  category: "", <record<category>>
  isTransfer: false,
  manualOverride: false,
  notes: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*]()
]

Category, category | Transaction category and category hierarchy node {
  id: $key,
  space!: "", <record<financialSpace>>
  key!: "",
  name!: "",
  categoryKind!: "expense", <"income" | "expense" | "transfer" | "tax" | "savings" | "other">
  parentCategory: "", <record<category>>
  active!: true,
  notes: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*]()
]

Merchant, merchant | Merchant, customer, vendor, or counterparty memory record {
  id: $key,
  space!: "", <record<financialSpace>>
  key!: "",
  name!: "",
  normalizedName: "",
  active!: true,
  notes: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*]()
]

ClassificationRule, classificationRule | Rule for automatic transaction matching and future classification suggestions {
  id: $key,
  space!: "", <record<financialSpace>>
  key!: "",
  name!: "",
  matcher!: "",
  scope!: "description", <"description" | "merchant" | "reference" | "amount">
  targetMerchant: "", <record<merchant>>
  targetCategory: "", <record<category>>
  priority: 0,
  active!: true,
  notes: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*]()
]

ClarificationTask, clarificationTask | Review task for uncertain transaction meaning {
  id: $key,
  space!: "", <record<financialSpace>>
  key!: "",
  transaction!: "", <record<transaction>>
  status!: "open", <"open" | "suggested" | "resolved" | "dismissed">
  question!: "",
  reason: "",
  suggestedSpace: "", <record<financialSpace>>
  suggestedMerchant: "", <record<merchant>>
  suggestedCategory: "", <record<category>>
  resolvedAt: "",
  resolutionNotes: "",
  confidence: 0,
  notes: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*]()
]

MonthlySnapshot, monthlySnapshot | Month-level financial truth snapshot for a financial space {
  id: S($space, $month),
  space!: "", <record<financialSpace>>
  month!: "",
  currency!: "ZAR",
  incomeTotal!: 0,
  outflowTotal!: 0,
  netTotal!: 0,
  transferTotal: 0,
  cashAvailable: 0,
  recurringTotal: 0,
  businessSpendTotal: 0,
  personalSpendTotal: 0,
  generatedAt!: "",
  status!: "draft", <"draft" | "final">
  notes: ""
} & {
  authority: "source"
} [
  crud,
  router,
  views:
    Admin[*]()
]
