// Golf Room booking domain graph (MPDG).
// Source of truth for generated specs, routers, functions, and types.

User, u | Golfroom user {
  id: $email
  email!: "", <email> <unique>
  firstName!: ""
  surname!: ""
  password!: "", <password {hash: argon2}> <assign>
  uniqueId: "", <md5<$email>> <assign>
} [
  crud
  router
  views:
    Admin[*]()
    Public::fn[firstName, surname, email, uniqueId, role<fetch>]()
  taxonomies:
    Role/Roles, role | User roles {} {
      hierarchical: false
      cardinality: one
      storeOnModel: true
      payloadField: role
      payloadAliases: [roles]
      required: true
      processor: functions
    }
  typesense:
    user::fn[id, email, firstName, surname, uniqueId](
      instances: $instances, <facet>
    ) {
      queryBy: [email, firstName, surname, uniqueId, instances]
      queryByWeights: [1, 1, 1, 1, 1]
      sortableFields: [surname]
      filters: [instances]
    }
  post
] (
) {}

Resource, resource | Bookable resource such as bay, coach, or facility {
  id: $key
  key!: ""
  name!: ""
  type!: "bay", <"bay" | "coach" | "facility">
  resourceCode!: ""
  handedness!: "n_a", <"right_only" | "left_capable" | "n_a">
  capacity!: 4
  timezone!: "Africa/Johannesburg"
  active!: true
  sortOrder: 0
  metadata: {}
} [
  crud<key>
  router
  views:
    Admin[*]()
  typesense:
    resource::fn[id, key, name, type, resourceCode, active](
      type: $type, <facet>
      active: $active, <facet>
    ) {
      queryBy: [key, name, resourceCode, type]
      sortableFields: [name]
      filters: [type, active]
    }
] (
) {}

ServiceDefinition, serviceDefinition | Booking flow configuration per CTA/service {
  id: $key
  key!: ""
  name!: ""
  ctaSlug!: ""
  serviceType!: "standard", <"standard" | "driving_range" | "kids_party" | "corporate" | "coaching">
  active!: true
  durationMode!: "selectable", <"fixed" | "selectable">
  fixedDurationMinutes: 0
  minDurationHours: 1
  maxDurationHours: 4
  durationStepHours: 1
  maxPlayersPerBay: 4
  maxPeoplePerBay: 6
  requiresBay!: true
  requiresCoach: false
  requiresOffPeakOnly: false
  supportsLeftHandedFilter: false
  autoAssignResources!: true
  maxHoldMinutes!: 10
  settings: {}
} [
  crud<key>
  router
  views:
    Admin[*]()
] (
) {}

Booking, booking | Customer booking record from hold through paid confirmation {
  id: $reference
  reference!: ""
  service!: "", <record<serviceDefinition>> <assign>
  status!: "held", <"held" | "pending_payment" | "paid_confirmed" | "cancelled" | "expired">
  paymentStatus!: "initiated", <"initiated" | "pending" | "paid" | "failed" | "cancelled">
  customerName!: ""
  customerEmail!: "", <email>
  customerMobile!: ""
  startAt!: time::now(), <datetime>
  endAt!: time::now(), <datetime>
  timezone!: "Africa/Johannesburg"
  timeBand!: "off_peak", <"peak" | "off_peak" | "mixed">
  players!: 1
  juniors: 0
  seniors: 0
  leftHandedRequired: false
  termsAccepted!: false
  marketingConsent: false
  specialRequests: ""
  holdExpiresAt: null, <datetime>
  subtotal!: 0
  discountTotal!: 0
  total!: 0
  currency!: "ZAR"
  promotionCode: ""
  promotionLabel: ""
  orderRef: ""
  metadata: {}
} [
  crud<reference>
  router
  views:
    Admin[*]()
] (
  *BookingParticipant, bookingParticipant | Booking participant snapshot {
    id: S($parent, $index)
    booking: $parent, <record<booking>> <assign>
    index!: 0
    fullName!: ""
    ageCategory!: "adult", <"adult" | "junior" | "senior">
    handedness!: "right", <"right" | "left">
    isPrimary!: false
  }
) {}

ResourceAvailabilityRule, resourceAvailabilityRule | Resource availability and peak/off-peak windows {
  id: $key
  key!: ""
  resource!: "", <record<resource>> <assign>
  service: "", <record<serviceDefinition>> <assign>
  dayOfWeek!: "all", <"monday" | "tuesday" | "wednesday" | "thursday" | "friday" | "saturday" | "sunday" | "all">
  startTime!: "00:00"
  endTime!: "23:59"
  band!: "off_peak", <"peak" | "off_peak" | "closed">
  slotIntervalMinutes!: 15
  minDurationMinutes!: 60
  maxDurationMinutes!: 240
  dateFrom: null, <datetime>
  dateTo: null, <datetime>
  blackout: false
  active!: true
  priority: 0
  metadata: {}
} [
  crud<key>
  router
  views:
    Admin[*]()
] (
) {}

BookingHold, bookingHold | Temporary slot reservation during checkout {
  id: $holdRef
  holdRef!: ""
  booking: "", <record<booking>> <assign>
  service!: "", <record<serviceDefinition>> <assign>
  status!: "active", <"active" | "expired" | "released" | "consumed">
  startAt!: time::now(), <datetime>
  endAt!: time::now(), <datetime>
  timezone!: "Africa/Johannesburg"
  expiresAt!: time::now(), <datetime>
  players!: 1
  leftHandedRequired: false
  resourceCount!: 1
  assignedResources: []
  customerEmail: "", <email>
  quote: {}
  source!: "public", <"public" | "admin" | "system">
  metadata: {}
} [
  crud<holdRef>
  router
  views:
    Admin[*]()
] (
) {}

BookingResourceAssignment, bookingResourceAssignment | Assigned resources for held/confirmed windows {
  id: $key
  key!: ""
  booking!: "", <record<booking>> <assign>
  hold: "", <record<bookingHold>> <assign>
  resource!: "", <record<resource>> <assign>
  service!: "", <record<serviceDefinition>> <assign>
  state!: "held", <"held" | "confirmed" | "cancelled" | "released">
  startAt!: time::now(), <datetime>
  endAt!: time::now(), <datetime>
  timezone!: "Africa/Johannesburg"
  assignedAt!: time::now(), <datetime>
  releasedAt: null, <datetime>
  metadata: {}
} [
  crud<key>
  router
  views:
    Admin[*]()
] (
) {}

PricingRateCard, pricingRateCard | Booking pricing matrix rows {
  id: $key
  key!: ""
  name!: ""
  service!: "", <record<serviceDefinition>> <assign>
  active!: true
  currency!: "ZAR"
  pricingMode!: "per_player_per_hour", <"per_player_per_hour" | "flat_per_bay" | "flat_per_child">
