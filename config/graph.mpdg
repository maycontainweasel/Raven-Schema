] (
) {}

PromotionRule, promotionRule | Promotional discounts evaluated against quote context {
  id: $key
  key!: ""
  name!: ""
  service: "", <record<serviceDefinition>> <assign>
  active!: true
  autoApply!: true
  promoCode: ""
  discountType!: "percentage", <"percentage" | "fixed_amount">
