  applyMode!: "best_only", <"best_only" | "stackable">
  target!: "booking_total", <"booking_total" | "player_line_item" | "service_total">
  minBookingTotal: 0
  maxDiscountAmount: 0
  maxUses: 0
  usedCount: 0
  effectiveFrom: null, <datetime>
  effectiveTo: null, <datetime>
  priority: 0
  conditions: {}
  metadata: {}
} [
  crud<key>
  router
  views:
