  subtotal!: 0
  discountTotal!: 0
  total!: 0
  currency!: "ZAR"
  paidAt: null, <datetime>
  cancelledAt: null, <datetime>
  metadata: {}
} [
  crud<orderRef>
  router
  views:
    Admin[*]()
] (
) {}

