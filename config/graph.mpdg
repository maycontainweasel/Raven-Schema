ContentItem, contentItem | CMS content item for blog, video, and photo records {
  id: $key
  key!: ""
  title!: ""
  slug!: ""
  type!: "blog", <"blog" | "video" | "photo">
  status!: "draft", <"draft" | "published" | "archived">
  excerpt: ""
  body: ""
  mediaUrl: ""
  coverImageUrl: ""
