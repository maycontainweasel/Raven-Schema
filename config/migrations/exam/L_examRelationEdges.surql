DEFINE TABLE OVERWRITE ExamQuestions SCHEMAFULL TYPE RELATION IN exam OUT q;
DEFINE FIELD OVERWRITE in ON TABLE ExamQuestions TYPE record<exam>;
DEFINE FIELD OVERWRITE out ON TABLE ExamQuestions TYPE record<q>;
DEFINE INDEX OVERWRITE ExamQuestions_unique ON TABLE ExamQuestions FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE ExamBuilderPage SCHEMAFULL TYPE RELATION IN exam OUT builderPage;
DEFINE FIELD OVERWRITE in ON TABLE ExamBuilderPage TYPE record<exam>;
DEFINE FIELD OVERWRITE out ON TABLE ExamBuilderPage TYPE record<builderPage>;
DEFINE INDEX OVERWRITE ExamBuilderPage_unique ON TABLE ExamBuilderPage FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE ExamAttempts SCHEMAFULL TYPE RELATION IN exam OUT qa;
DEFINE FIELD OVERWRITE in ON TABLE ExamAttempts TYPE record<exam>;
DEFINE FIELD OVERWRITE out ON TABLE ExamAttempts TYPE record<qa>;
DEFINE INDEX OVERWRITE ExamAttempts_unique ON TABLE ExamAttempts FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE ExamSessions SCHEMAFULL TYPE RELATION IN exam OUT s;
DEFINE FIELD OVERWRITE in ON TABLE ExamSessions TYPE record<exam>;
DEFINE FIELD OVERWRITE out ON TABLE ExamSessions TYPE record<s>;
DEFINE INDEX OVERWRITE ExamSessions_unique ON TABLE ExamSessions FIELDS in, out UNIQUE;
