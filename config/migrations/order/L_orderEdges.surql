DEFINE TABLE OVERWRITE OrderEvent SCHEMAFULL TYPE RELATION IN order OUT orderEvent;
DEFINE FIELD OVERWRITE in ON TABLE OrderEvent TYPE record<order>;
DEFINE FIELD OVERWRITE out ON TABLE OrderEvent TYPE record<orderEvent>;
DEFINE INDEX OVERWRITE OrderEvent_unique ON TABLE OrderEvent FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE OrderItem SCHEMAFULL TYPE RELATION IN order OUT orderItem;
DEFINE FIELD OVERWRITE in ON TABLE OrderItem TYPE record<order>;
DEFINE FIELD OVERWRITE out ON TABLE OrderItem TYPE record<orderItem>;
DEFINE INDEX OVERWRITE OrderItem_unique ON TABLE OrderItem FIELDS in, out UNIQUE;
