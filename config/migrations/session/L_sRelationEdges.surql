DEFINE TABLE OVERWRITE SessionAttempts SCHEMAFULL TYPE RELATION IN s OUT qa;
DEFINE FIELD OVERWRITE in ON TABLE SessionAttempts TYPE record<s>;
DEFINE FIELD OVERWRITE out ON TABLE SessionAttempts TYPE record<qa>;
DEFINE INDEX OVERWRITE SessionAttempts_unique ON TABLE SessionAttempts FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE SessionQuestions SCHEMAFULL TYPE RELATION IN s OUT q;
DEFINE FIELD OVERWRITE in ON TABLE SessionQuestions TYPE record<s>;
DEFINE FIELD OVERWRITE out ON TABLE SessionQuestions TYPE record<q>;
DEFINE INDEX OVERWRITE SessionQuestions_unique ON TABLE SessionQuestions FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE SessionRecord SCHEMAFULL TYPE RELATION IN s OUT spr;
DEFINE FIELD OVERWRITE in ON TABLE SessionRecord TYPE record<s>;
DEFINE FIELD OVERWRITE out ON TABLE SessionRecord TYPE record<spr>;
DEFINE INDEX OVERWRITE SessionRecord_unique ON TABLE SessionRecord FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE SessionLog SCHEMAFULL TYPE RELATION IN s OUT slog;
DEFINE FIELD OVERWRITE in ON TABLE SessionLog TYPE record<s>;
DEFINE FIELD OVERWRITE out ON TABLE SessionLog TYPE record<slog>;
DEFINE INDEX OVERWRITE SessionLog_unique ON TABLE SessionLog FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE SessionCategories SCHEMAFULL TYPE RELATION IN s OUT qt;
DEFINE FIELD OVERWRITE in ON TABLE SessionCategories TYPE record<s>;
DEFINE FIELD OVERWRITE out ON TABLE SessionCategories TYPE record<qt>;
DEFINE INDEX OVERWRITE SessionCategories_unique ON TABLE SessionCategories FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE SessionCategoryRecords SCHEMAFULL TYPE RELATION IN s OUT scr;
DEFINE FIELD OVERWRITE in ON TABLE SessionCategoryRecords TYPE record<s>;
DEFINE FIELD OVERWRITE out ON TABLE SessionCategoryRecords TYPE record<scr>;
DEFINE INDEX OVERWRITE SessionCategoryRecords_unique ON TABLE SessionCategoryRecords FIELDS in, out UNIQUE;
