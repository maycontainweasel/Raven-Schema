DEFINE TABLE OVERWRITE UserAttempts SCHEMAFULL TYPE RELATION IN u OUT qa;
DEFINE FIELD OVERWRITE in ON TABLE UserAttempts TYPE record<u>;
DEFINE FIELD OVERWRITE out ON TABLE UserAttempts TYPE record<qa>;
DEFINE INDEX OVERWRITE UserAttempts_unique ON TABLE UserAttempts FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE UserSessions SCHEMAFULL TYPE RELATION IN u OUT s;
DEFINE FIELD OVERWRITE in ON TABLE UserSessions TYPE record<u>;
DEFINE FIELD OVERWRITE out ON TABLE UserSessions TYPE record<s>;
DEFINE INDEX OVERWRITE UserSessions_unique ON TABLE UserSessions FIELDS in, out UNIQUE;
