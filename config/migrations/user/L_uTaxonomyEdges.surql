DEFINE TABLE OVERWRITE UserRoleTerms SCHEMAFULL TYPE RELATION IN tax OUT t_u_role;
DEFINE FIELD OVERWRITE in ON TABLE UserRoleTerms TYPE record<tax>;
DEFINE FIELD OVERWRITE out ON TABLE UserRoleTerms TYPE record<t_u_role>;
DEFINE INDEX OVERWRITE UserRoleTerms_unique ON TABLE UserRoleTerms FIELDS in, out UNIQUE;

DEFINE TABLE OVERWRITE UserRoles SCHEMAFULL TYPE RELATION IN u OUT t_u_role;
DEFINE FIELD OVERWRITE in ON TABLE UserRoles TYPE record<u>;
DEFINE FIELD OVERWRITE out ON TABLE UserRoles TYPE record<t_u_role>;
DEFINE INDEX OVERWRITE UserRoles_unique ON TABLE UserRoles FIELDS in, out UNIQUE;
