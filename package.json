{
  "name": "schema",
  "version": "1.0.0",
  "description": "A SurrealDB schema tooling workspace for MPD",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "scaffold": "tsx src/cli.ts",
    "watch": "tsx watch src/main.ts",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "schema:generate": "tsx src/cli.ts generate",
    "schema:refresh": "tsx src/cli.ts refresh",
    "schema:module:sync": "tsx src/cli.ts schema-kit:sync",
    "schema:layers:sync": "tsx src/cli.ts layers:sync",
    "schema:module:clear": "tsx src/cli.ts schema-kit:clear",
    "schema:generate:modules": "tsx src/cli.ts generate:modules",
    "schema:import": "tsx src/cli.ts import",
    "schema:import:functions": "tsx src/cli.ts import:functions",
    "schema:assets:diff": "tsx src/cli.ts assets:diff",
    "schema:assets:sync": "tsx src/cli.ts assets:sync",
    "schema:indexes:rebuild": "tsx src/cli.ts indexes:rebuild",
    "schema:sync": "node scripts/sync.mjs",
    "schema:bootstrap": "tsx src/cli.ts bootstrap",
    "schema:bootstrap:seed": "tsx src/cli.ts bootstrap:seed",
    "schema:request-schema": "tsx src/cli.ts request-schema:generate",
    "site:create": "tsx src/cli.ts site:create",
    "site:delete": "tsx src/cli.ts site:delete",
    "site:env:sync": "tsx src/cli.ts site:env:sync",
    "site:env": "tsx src/cli.ts site:env",
    "site:env:sync:yaml": "tsx src/cli.ts site:env:sync:yaml",
    "site:pm2:logs": "tsx src/cli.ts site:pm2:logs",
    "site:remove": "tsx src/cli.ts site:remove",
    "site:remove:local": "tsx src/cli.ts site:remove:local",
    "site:remove:remote": "tsx src/cli.ts site:remove:remote",
    "site:pkg:sync": "tsx src/cli.ts site:pkg:sync",
    "site:pkg:add": "tsx src/cli.ts site:pkg:add",
    "site:setup": "tsx src/cli.ts site:setup",
    "site:config:sync": "tsx src/cli.ts site:config:sync",
    "site:deploy:init": "tsx src/cli.ts site:deploy:init",
    "site:deploy:setup": "tsx src/cli.ts site:deploy:setup",
    "site:deploy:ssl": "tsx src/cli.ts site:deploy:ssl",
    "site:deploy": "tsx src/cli.ts site:deploy",
    "site:adopt": "tsx src/cli.ts site:adopt",
    "site:project:setup": "tsx src/cli.ts project:setup",
    "site:layers:sync": "tsx src/cli.ts site:layers:sync",
    "site:layers:status": "tsx src/cli.ts site:layers:status",
    "site:layers:add": "tsx src/cli.ts site:layers:add",
    "site:layers:remove": "tsx src/cli.ts site:layers:remove",
    "site:helios:setup": "tsx src/cli.ts site:helios:setup",
    "layers:status": "tsx src/cli.ts site:layers:status",
    "layers:add": "tsx src/cli.ts site:layers:add",
    "layers:remove": "tsx src/cli.ts site:layers:remove",
    "nuxt": "tsx src/cli.ts site:create",
    "schema:nginx:setup": "tsx src/cli.ts nginx:setup",
    "schema:nginx:config": "tsx src/cli.ts nginx:config",
    "schema:ui:generate": "tsx src/cli.ts ui:generate",
    "schema:ui:generate:test": "tsx src/cli.ts ui:generate --spec test --project pmv2-admin",
    "schema:ui:generate:exam": "tsx src/cli.ts ui:generate --spec exam --project pmv2-admin",
    "schema:ui:generate:question": "tsx src/cli.ts ui:generate --spec question --project pmv2-admin",
    "schema:ui:generate:users": "tsx src/cli.ts ui:generate --spec users --project pmv2-admin",
    "project:setup": "tsx src/cli.ts project:setup",
    "project:fix": "tsx src/cli.ts project:fix",
    "schema:spec:mpdg": "tsx scripts/mpdg-to-spec.ts",
    "schema:spec:mpdg:live": "tsx scripts/mpdg-to-spec.ts --mode live --force",
    "graph:spec": "pnpm run schema:spec:mpdg",
    "graph:spec:live": "pnpm run schema:spec:mpdg:live",
    "graph:mermaid": "tsx scripts/gen-graph-mpdg.ts",
    "graph:ids": "tsx scripts/gen-ids-mpdg.ts",
    "spec": "pnpm run graph:spec && pnpm run graph:mermaid",
    "spec:copy": "tsx scripts/spec-copy.ts"
  },
  "keywords": [
    "typescript",
    "node",
    "template",
    "baseline"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "zod": "4.1.12"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "surrealdb": "2.0.0-alpha.16",
    "yaml": "^2.4.2",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
